# Copy to .env and fill in. Never commit .env.
# Generate values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
# Fernet key for the PII vault and encrypted raw records:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_VAULT_KEY=

# Used only by `python -m app.cli create-user` (avoids putting passwords in shell history)
PAYNEST_NEW_USER_PASSWORD=

# Local backend development outside Docker (backend/.env or exported in your shell)
# DATABASE_URL=postgresql+asyncpg://paynest:<POSTGRES_PASSWORD>@localhost:5432/paynest
# TEST_DATABASE_URL=postgresql+asyncpg://paynest:<POSTGRES_PASSWORD>@localhost:5432/paynest_test

# Model providers (Phase 3). "none" = no model: AI steps record "unavailable" and route to people.
LLM_PROVIDER=none
EMBEDDING_PROVIDER=none
BEDROCK_REGION=ap-south-1
# Confirm the model id and its in-region availability before setting these.
BEDROCK_CLASSIFIER_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
